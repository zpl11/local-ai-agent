# ============================================================================
# 本地 AI 聊天客户端配置示例模板
# 使用方法：复制本文件为 .env，并修改为您本地或局域网的实际模型服务地址
# ============================================================================

# 大模型配置（OpenAI 兼容 API）
LARGE_MODEL_URL=http://127.0.0.1:8000
LARGE_MODEL_NAME=qwen3-next-80b-a3b
LARGE_CTX_MAX=16384

# 小模型配置（后台摘要/清洗）
SMALL_MODEL_URL=http://127.0.0.1:8080
SMALL_MODEL_NAME=qwen3.8-27b

# 运行时配置
SUMMARIZE_THRESHOLD=0.75       # 上下文使用率超过此阈值触发小模型后台摘要
TIMEOUT=360                    # 大模型请求超时（秒）
SUMMARIZE_TIMEOUT=60           # 小模型摘要超时（秒）
MAX_TOOL_CALLS=50              # 单轮对话最大迭代轮数，防死循环
MAX_LINES_PER_PAGE=200         # 文件读取每页最大行数（硬限制）
